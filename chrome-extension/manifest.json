{
  "manifest_version": 3,
  "name": "VideoPaste",
  "version": "0.1.1",
  "minimum_chrome_version": "105",
  "description": "Sends a Reddit or X video URL you choose to the local VideoPaste helper so it can download and copy the video.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background/native-bridge.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://reddit.com/*",
        "*://*.reddit.com/*",
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*"
      ],
      "css": [
        "content/videopaste.css"
      ],
      "js": [
        "content/runtime.js",
        "content/videopaste.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
