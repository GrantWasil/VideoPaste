{
  "manifest_version": 3,
  "name": "VideoPaste",
  "version": "0.1.0",
  "description": "Downloads Reddit videos and copies them through a lightweight native helper.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "videopaste@grantwasil",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "scripts": [
      "background/native-bridge.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://reddit.com/*",
        "*://*.reddit.com/*"
      ],
      "css": [
        "content/videopaste.css"
      ],
      "js": [
        "content/videopaste.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
