{
  "manifest_version": 3,
  "name": "VideoPaste",
  "version": "0.1.0",
  "description": "Sends a Reddit or X video URL you choose to the local VideoPaste helper so it can download and copy the video.",
  "homepage_url": "https://github.com/GrantWasil/VideoPaste",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "videopaste@grantwasil",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "scripts": [
      "background/native-bridge.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://reddit.com/*",
        "*://*.reddit.com/*",
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*"
      ],
      "css": [
        "content/videopaste.css"
      ],
      "js": [
        "content/videopaste.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
